---
/**
 * Company Salary Breakdown Pages: /company/[slug]
 * 8 illustrative company salary simulations with clear demarcation between
 * verified offer letter facts and editable assumptions.
 * Date of baseline: October 2026.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { calculateSalary } from '../../utils/salaryEngine';
import { formatINR } from '../../utils/formatCurrency';

interface CompanyTrack {
  slug: string;
  companyName: string;
  roleTitle: string;
  headlineCTC: number;
  badgeText: string;
  verifiedSourceDate: string;
  sourceDoc: string;
  sourceUrl: string;
  summary: string;
  facts: {
    monthlyBasic: number;
    annualBasic: number;
    monthlyHRA: number;
    annualHRA: number;
    monthlySpecial: number;
    annualSpecial: number;
    variablePay: number;
    joiningBonus: number;
    monthlyEmployerPF: number;
    annualEmployerPF: number;
    monthlyGratuity: number;
    annualGratuity: number;
    otherEmployerCosts: number;
  };
  assumptions: {
    variablePayoutDefaultPct: number;
    variableExplanation: string;
    ptMonthly: number;
    insuranceNote: string;
  };
  faqs: { q: string; a: string }[];
}

