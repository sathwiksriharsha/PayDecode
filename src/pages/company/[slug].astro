export async function getStaticPaths() {
  return COMPANY_TRACKS.map((track) => ({
    params: { slug: track.slug },
    props: { track },
  }));
}

interface Props {
  track: CompanyTrack;
}

const { track } = Astro.props;

// Calculate salary breakdown using the financial engine
const breakdown = calculateSalary({
  annualCTC: track.headlineCTC,
  basicPercent: Math.round((track.facts.annualBasic / track.headlineCTC) * 100),
  targetVariablePay: track.facts.variablePay,
  joiningBonus: track.facts.joiningBonus,
  pfPolicy: 'statutory_ceiling',
  regime: 'new',
});

const title = `${track.companyName} (${track.roleTitle}) Salary Breakdown 2026–27 | Real In-Hand Pay`;
const description = `Detailed salary structure for ${track.roleTitle} at ${track.companyName} (${formatINR(track.headlineCTC)} CTC). Illustrative package baseline, monthly bank credit (${formatINR(breakdown.monthlyInHand)}), EPF, and tax details.`;
const canonicalPath = `/company/${track.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${track.roleTitle} — Real Salary Decomposition & In-Hand Analysis`,
  description,
  url: `${site.url}${canonicalPath}`,
  author: { '@type': 'Organization', name: site.name },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: track.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Breadcrumb -->
  <div class="container mt-lg mb-lg">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/ctc-to-inhand-calculator">Calculators</a>
      <span class="breadcrumb-sep">›</span>
      <span>{track.roleTitle}</span>
    </nav>
  </div>

  <div class="container">
    <div class="calc-layout">

      <!-- ═══ Left: Hero Summary Card & Assumptions Toggle ═══ -->
      <div class="calc-inputs">
        <div class="card card-hero-result">
          <div class="hero-result-header">
            <span class="hero-result-label">{track.companyName}</span>
            <span class="badge badge-success">New Regime 2026–27</span>
          </div>

          <div class="hero-result-amount text-success">{formatINR(breakdown.monthlyInHand)} / mo</div>
          <div class="hero-result-sub">
            Estimated Monthly Bank Credit ({formatINR(breakdown.annualInHand)} annual take-home)
          </div>

          <div class="hero-stats-grid mt-lg">
            <div class="hero-stat-box">
              <span class="stat-caption">Headline CTC</span>
              <span class="stat-val font-mono">{formatINR(track.headlineCTC)}</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Annual Income Tax</span>
              <span class="stat-val font-mono text-success">₹0 (Sec 156 Rebate)</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Monthly Employee PF</span>
              <span class="stat-val font-mono">{formatINR(breakdown.monthlyEmployeePF)}</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Monthly Gross</span>
              <span class="stat-val font-mono">{formatINR(breakdown.monthlyGross)}</span>
            </div>
          </div>
        </div>

        <!-- Publicly Reported Baseline vs Editable Assumptions Notice & Independent Disclaimer -->
        <div class="card mt-lg">
          <div class="badge badge-accent mb-xs">Illustrative Simulation</div>
          <h3 class="title-sm mb-xs">Publicly Reported Package Baseline</h3>
          <p class="body-sm text-muted mb-sm">
            {track.summary}
          </p>
          <div class="source-audit-box p-sm bg-soft border rounded caption">
            <p class="mb-xxs"><strong>Baseline Reference:</strong> {track.sourceDoc}</p>
            <p class="mb-xxs"><strong>Reference Period:</strong> {track.verifiedSourceDate}</p>
            <p class="mb-0"><strong>Careers Portal:</strong> <a href={track.sourceUrl} target="_blank" rel="noopener noreferrer" class="link-underline">Visit {track.companyName} Careers</a></p>
          </div>
          <div class="disclaimer-callout mt-sm p-sm border rounded bg-surface caption">
            <strong>Independent Disclaimer:</strong> PayDecode is an independent educational tool and is <strong>unaffiliated with {track.companyName}</strong> or any named employer. Actual compensation structures, basic-pay percentages, variable bonus distributions, and retirals vary across joining batches, business units, job bands, and individual contracts. Figures shown are illustrative simulations based on publicly reported compensation architectures.
          </div>
        </div>

        <!-- Customizer Link -->
        <div class="card mt-lg">
          <h3 class="title-sm mb-xs">Want to Simulate Custom Scenarios?</h3>
          <p class="body-sm text-muted mb-md">
            Test different variable bonus payouts, city rents, or compare this offer against another company offer letter.
          </p>
          <a href={`/ctc-to-inhand-calculator`} class="btn btn-primary btn-block">
            Open Interactive CTC Calculator →
          </a>
        </div>

        <!-- Other Company Tracks -->
        <div class="card mt-lg bg-soft">
          <h3 class="title-sm mb-xs">Other Popular Company Packages</h3>
          <div class="company-links-list mt-sm">
            {COMPANY_TRACKS.filter((t) => t.slug !== track.slug).map((c) => (
              <a href={`/company/${c.slug}`} class="company-sub-link">
                <span>{c.roleTitle}</span>
                <span class="font-mono text-muted">{formatINR(c.headlineCTC)}</span>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- ═══ Right: Compensation Architecture & Decomposition ═══ -->
      <div class="calc-results">

        <div class="card">
          <div class="badge badge-primary mb-xs">Illustrative Package Baseline (Editable Assumptions)</div>
          <h1 class="display-sm mb-xs">{track.roleTitle} Salary Structure</h1>
          <p class="body-sm text-muted mb-xl">
            Complete compensation architecture for ₹{track.headlineCTC.toLocaleString('en-IN')} CTC under the Income-tax Act, 2025.
          </p>

          <!-- Distinction Legend -->
          <div class="legend-bar mb-lg p-sm bg-soft border rounded">
            <span class="legend-item"><span class="bullet bullet-verified">●</span> <strong>Illustrative Package Baseline</strong> (Publicly reported contract structure)</span>
            <span class="legend-item"><span class="bullet bullet-assumption">●</span> <strong>Editable Assumption</strong> (Variable payout, state PT)</span>
          </div>

          <h2 class="title-sm mb-sm">1. Cash Salary Components (Monthly & Annual)</h2>
          <div class="table-container mb-lg">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Classification</th>
                  <th class="text-right">Monthly</th>
                  <th class="text-right">Annual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Basic Salary</td>
                  <td><span class="badge badge-success">Reported Structure</span></td>
                  <td class="text-right font-mono">{formatINR(track.facts.monthlyBasic)}</td>
                  <td class="text-right font-mono">{formatINR(track.facts.annualBasic)}</td>
                </tr>
                <tr>
                  <td>House Rent Allowance (HRA)</td>
                  <td><span class="badge badge-success">Reported Structure</span></td>
                  <td class="text-right font-mono">{formatINR(track.facts.monthlyHRA)}</td>
                  <td class="text-right font-mono">{formatINR(track.facts.annualHRA)}</td>
                </tr>
                <tr>
                  <td>Special / City Allowance</td>
                  <td><span class="badge badge-success">Reported Structure</span></td>
                  <td class="text-right font-mono">{formatINR(track.facts.monthlySpecial)}</td>
                  <td class="text-right font-mono">{formatINR(track.facts.annualSpecial)}</td>
                </tr>
                <tr>
                  <td>Performance Variable Pay (Target)</td>
                  <td><span class="badge badge-accent">Assumption</span></td>
                  <td class="text-right font-mono">{formatINR(Math.round(track.facts.variablePay / 12))}</td>
                  <td class="text-right font-mono">{formatINR(track.facts.variablePay)}</td>
                </tr>
                {track.facts.joiningBonus > 0 && (
                  <tr>
                    <td>One-Time Joining Bonus</td>
                    <td><span class="badge badge-accent">One-Time (Year 1)</span></td>
                    <td class="text-right font-mono">—</td>
                    <td class="text-right font-mono">{formatINR(track.facts.joiningBonus)}</td>
                  </tr>
                )}
                <tr style="font-weight:700; background:var(--color-surface-soft);">
                  <td>Total Cash Gross (Before Deductions)</td>
                  <td>—</td>
                  <td class="text-right font-mono">{formatINR(breakdown.monthlyGross)}</td>
                  <td class="text-right font-mono">{formatINR(breakdown.annualGross)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 class="title-sm mb-sm">2. Monthly Payroll Deductions</h2>
          <div class="table-container mb-lg">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Deduction Item</th>
                  <th>Statutory Mandate</th>
                  <th class="text-right">Monthly</th>
                  <th class="text-right">Annual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
