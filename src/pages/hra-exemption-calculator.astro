---
/**
 * HRA Exemption Calculator (House Rent Allowance Tax Exemption)
 * Calculates tax-free HRA under the 3-point statutory rule.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const title = 'HRA Exemption Calculator 2026–27 | Calculate Tax-Free House Rent Allowance';
const description = 'Calculate your tax-exempt House Rent Allowance (HRA) using the official 3-rule formula for Metro and Non-Metro cities. See taxable HRA, tax savings, and landlord PAN requirements.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${title} — ${site.name}`,
  description,
  url: `${site.url}/hra-exemption-calculator`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'HRA Exemption Calculator', item: `${site.url}/hra-exemption-calculator` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the formula for HRA tax exemption in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HRA tax exemption is the lowest of three conditions: 1) Actual HRA received from your employer, 2) Rent paid minus 10% of basic salary, or 3) 50% of basic salary for metro cities (Delhi, Mumbai, Kolkata, Chennai) or 40% for non-metro cities.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I claim HRA exemption under the New Tax Regime?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. HRA exemption is not available under the New Tax Regime (Section 202 of Income-tax Act, 2025). It can only be claimed if you opt for the Old Tax Regime.',
      },
    },
    {
      '@type': 'Question',
      name: 'When is a landlord PAN mandatory for claiming HRA?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'If your annual rent payment exceeds ₹1,00,000 (approx ₹8,333 per month), it is mandatory under Income Tax rules to submit your landlord\'s PAN to your employer for TDS exemption.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/hra-exemption-calculator"
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Breadcrumb -->
  <div class="container mt-lg mb-lg">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">›</span>
      <span>HRA Exemption Calculator</span>
    </nav>
  </div>

  <div class="container">
    <div class="calc-layout">

      <!-- ═══ Left: Input Panel ═══ -->
      <div class="calc-inputs">
        <div class="card">
          <div class="badge badge-accent mb-sm">Old Regime Tax Tool</div>
          <h1 class="display-sm mb-xs">HRA Exemption Calculator</h1>
          <p class="body-sm text-muted mb-xl">
            House Rent Allowance calculation based on official 3-rule formula. Note: HRA exemption applies exclusively under the Old Tax Regime.
          </p>

          <!-- Annual Basic Salary -->
          <div class="input-group">
            <label for="hra-basic" class="input-label">Annual Basic Salary (+ DA if applicable)</label>
            <div class="input-with-prefix">
              <span class="input-prefix">₹</span>
              <input type="text" id="hra-basic" class="input input-number" value="600000" placeholder="e.g. 6,00,000" />
            </div>
          </div>

          <!-- Annual HRA Received -->
          <div class="input-group">
            <label for="hra-received" class="input-label">Annual HRA Received from Employer</label>
            <div class="input-with-prefix">
              <span class="input-prefix">₹</span>
              <input type="text" id="hra-received" class="input input-number" value="240000" placeholder="e.g. 2,40,000" />
            </div>
          </div>

          <!-- Total Rent Paid -->
          <div class="input-group">
            <label for="hra-rent" class="input-label">Total Annual Rent Paid</label>
            <div class="input-with-prefix">
              <span class="input-prefix">₹</span>
              <input type="text" id="hra-rent" class="input input-number" value="216000" placeholder="e.g. 2,16,000 (18k/mo)" />
            </div>
          </div>

          <!-- City Type -->
          <div class="input-group">
            <label class="input-label">City of Residence</label>
            <div class="radio-group">
              <label class="radio-pill">
                <input type="radio" name="metro" value="metro" checked /> Metro (50% basic)
              </label>
              <label class="radio-pill">
                <input type="radio" name="metro" value="non-metro" /> Non-Metro (40% basic)
              </label>
            </div>
            <p class="caption text-muted mt-xs">
              Metro cities defined by IT Department: Delhi, Mumbai, Kolkata, Chennai.
            </p>
          </div>

          <button id="calc-hra-btn" class="btn btn-primary btn-block mt-md">
            Calculate HRA Exemption
          </button>
        </div>

        <!-- Ad Slot -->
        <div class="ad-container-outer mt-lg">
          <div class="ad-label">Advertisement</div>
          <div class="ad-slot ad-responsive" id="ad-slot-hra-1">
            <div class="ad-placeholder">
              <span>Rental Agreements & Zero Brokerage Housing Portals</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Right: Result Panel ═══ -->
      <div class="calc-results">
        <!-- Result Hero Card -->
        <div class="card card-hero-result" id="hra-hero-card">
          <div class="hero-result-header">
            <span class="hero-result-label">Tax-Exempt HRA Amount</span>
            <span class="badge badge-success" id="hra-badge">100% Tax Free</span>
          </div>

          <div class="hero-result-amount text-success" id="res-exempt-hra">₹1,56,000</div>
          <div class="hero-result-sub" id="res-exempt-monthly">₹13,000 tax-free per month</div>

          <div class="hero-stats-grid mt-lg">
            <div class="hero-stat-box">
              <span class="stat-caption">Taxable HRA</span>
              <span class="stat-val text-danger" id="res-taxable-hra">₹84,000</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Estimated Tax Saved</span>
              <span class="stat-val text-success" id="res-tax-saved">₹48,672</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Monthly Rent Paid</span>
              <span class="stat-val" id="res-monthly-rent">₹18,000</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Landlord PAN</span>
              <span class="stat-val" id="res-pan-status">Required (&gt; ₹1L)</span>
            </div>
          </div>
        </div>

        <!-- 3-Condition Rule Breakdown -->
        <div class="card mt-lg">
          <h2 class="title-sm mb-xs">Official 3-Condition Breakdown</h2>
          <p class="caption text-muted mb-md">
            The Income Tax Department allows exemption on the lowest of the following 3 amounts:
          </p>

          <div class="three-rules-list">
            <div class="rule-item" id="rule-1-box">
              <div class="rule-num">1</div>
              <div class="rule-content">
                <span class="rule-title">Actual HRA Received</span>
                <span class="rule-desc">Received from your employer</span>
              </div>
              <div class="rule-val" id="rule-1-val">₹2,40,000</div>
            </div>

            <div class="rule-item" id="rule-2-box">
              <div class="rule-num">2</div>
              <div class="rule-content">
                <span class="rule-title">Rent Paid minus 10% of Basic</span>
                <span class="rule-desc" id="rule-2-formula">₹2,16,000 - ₹60,000 (10% of 6L)</span>
              </div>
              <div class="rule-val" id="rule-2-val">₹1,56,000</div>
            </div>

            <div class="rule-item" id="rule-3-box">
              <div class="rule-num">3</div>
              <div class="rule-content">
                <span class="rule-title" id="rule-3-title">50% of Basic Salary (Metro)</span>
                <span class="rule-desc">50% of annual basic salary</span>
              </div>
              <div class="rule-val" id="rule-3-val">₹3,00,000</div>
            </div>
          </div>

          <div class="lowest-pill mt-md" id="lowest-rule-tag">
            Condition 2 applies (lowest amount): Exempt HRA = ₹1,56,000
          </div>
        </div>

        <!-- Ad Slot 2 -->
        <div class="ad-container-outer mt-lg">
          <div class="ad-label">Advertisement</div>
          <div class="ad-slot ad-responsive" id="ad-slot-hra-2">
            <div class="ad-placeholder">
              <span>Home Loans & Rent Receipt Generators</span>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- ═══ SEO Educational Guide ═══ -->
    <section class="seo-guide mt-xxl pt-xl border-top">
      <div class="max-content-text">
        <h2 class="display-sm mb-md">Complete Guide to House Rent Allowance (HRA) Exemption</h2>
        <p class="body-md text-body mb-lg">
          House Rent Allowance (HRA) is one of the most substantial salary exemptions available to salaried individuals living in rented accommodations in India.
        </p>

        <h3 class="title-lg mb-sm">Important Rules and Documents Required</h3>
        <ul class="seo-list mb-lg">
          <li><strong>Rent Receipts:</strong> Always collect stamped or signed rent receipts from your landlord for every month.</li>
          <li><strong>Registered Rent Agreement:</strong> Employers and tax assessment officers require a copy of your valid lease agreement.</li>
          <li><strong>Landlord PAN Mandatory above ₹1 Lakh/year:</strong> If your total rent paid in a financial year exceeds ₹1,00,000, you must submit your landlord's PAN. If your landlord does not have a PAN, a signed declaration (Form 60) is required.</li>
          <li><strong>Paying Rent to Parents:</strong> You can legally pay rent to your parents and claim HRA, provided your parents own the property, you transfer the rent via bank transfer, and your parents report this rental income in their income tax return.</li>
        </ul>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .calc-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 992px) {
    .calc-layout {
      grid-template-columns: 460px 1fr;
    }
  }

  .card-hero-result {
    background: linear-gradient(135deg, #0a0b0d 0%, #16181c 100%);
    color: #ffffff;
    border-radius: var(--rounded-lg);
    padding: var(--space-xl);
  }

  .hero-result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .hero-result-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-on-dark-soft);
  }

  .hero-result-amount {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    font-family: var(--font-mono);
  }

  .hero-result-sub {
    font-size: 13px;
    color: var(--color-on-dark-soft);
    margin-top: var(--space-xxs);
  }

  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-stat-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-caption {
    font-size: 11px;
    color: var(--color-on-dark-soft);
    text-transform: uppercase;
  }

  .stat-val {
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .three-rules-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .rule-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    background: var(--color-canvas);
  }

  .rule-item.active-winner {
    border-color: #05b169;
    background: rgba(5, 177, 105, 0.04);
  }

  .rule-num {
    width: 28px;
    height: 28px;
    border-radius: var(--rounded-full);
    background: var(--color-surface-strong);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
  }

  .rule-item.active-winner .rule-num {
    background: #05b169;
    color: #ffffff;
  }

  .rule-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .rule-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .rule-desc {
    font-size: 12px;
    color: var(--color-muted);
  }

  .rule-val {
    font-size: 16px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .lowest-pill {
    padding: var(--space-sm) var(--space-md);
    background: rgba(5, 177, 105, 0.1);
    color: #05b169;
    border-radius: var(--rounded-md);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .text-success { color: #05b169 !important; }
  .text-danger { color: #ff5252 !important; }

  .ad-container-outer {
    background: var(--color-surface-soft);
    border: 1px dashed var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: var(--space-xs);
    text-align: center;
  }

  .ad-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-muted-soft);
    margin-bottom: var(--space-xxs);
  }

  .ad-slot {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ad-placeholder {
    font-size: 12px;
    color: var(--color-muted);
  }

  .max-content-text {
    max-width: 800px;
    margin: 0 auto;
  }

  .seo-list {
    padding-left: var(--space-lg);
    line-height: 1.8;
    color: var(--color-body);
  }
</style>

<script>
  import { calculateHRAExemption } from '../utils/taxEngine';
  import { parseSalaryInput, formatINR } from '../utils/formatCurrency';

  const basicInput = document.getElementById('hra-basic') as HTMLInputElement;
  const receivedInput = document.getElementById('hra-received') as HTMLInputElement;
  const rentInput = document.getElementById('hra-rent') as HTMLInputElement;
  const calcBtn = document.getElementById('calc-hra-btn') as HTMLButtonElement;

  // Outputs
  const resExemptHra = document.getElementById('res-exempt-hra')!;
  const resExemptMonthly = document.getElementById('res-exempt-monthly')!;
  const resTaxableHra = document.getElementById('res-taxable-hra')!;
  const resTaxSaved = document.getElementById('res-tax-saved')!;
  const resMonthlyRent = document.getElementById('res-monthly-rent')!;
  const resPanStatus = document.getElementById('res-pan-status')!;

  const rule1Val = document.getElementById('rule-1-val')!;
  const rule2Val = document.getElementById('rule-2-val')!;
  const rule2Formula = document.getElementById('rule-2-formula')!;
  const rule3Val = document.getElementById('rule-3-val')!;
  const rule3Title = document.getElementById('rule-3-title')!;
  const lowestRuleTag = document.getElementById('lowest-rule-tag')!;

  const box1 = document.getElementById('rule-1-box')!;
  const box2 = document.getElementById('rule-2-box')!;
  const box3 = document.getElementById('rule-3-box')!;

  function runHraCalc() {
    const basic = parseSalaryInput(basicInput.value) || 0;
    const received = parseSalaryInput(receivedInput.value) || 0;
    const rent = parseSalaryInput(rentInput.value) || 0;
    const isMetro = (document.querySelector('input[name="metro"]:checked') as HTMLInputElement)?.value === 'metro';

    const exemptAmount = calculateHRAExemption(received, rent, basic, isMetro);
    const taxableAmount = Math.max(0, received - exemptAmount);

    // Rule 1: Actual HRA
    const rule1 = received;
    // Rule 2: Rent minus 10% basic
    const tenPctBasic = Math.round(basic * 0.10);
    const rule2 = Math.max(0, rent - tenPctBasic);
    // Rule 3: 50% or 40% basic
    const metroPct = isMetro ? 0.50 : 0.40;
    const rule3 = Math.round(basic * metroPct);

    // Display
    resExemptHra.textContent = formatINR(exemptAmount);
    resExemptMonthly.textContent = `₹${Math.round(exemptAmount / 12).toLocaleString('en-IN')} tax-free per month`;
    resTaxableHra.textContent = formatINR(taxableAmount);
    // Estimated tax saved at 30% slab + 4% cess = 31.2%
    const taxSaved = Math.round(exemptAmount * 0.312);
    resTaxSaved.textContent = formatINR(taxSaved);
    resMonthlyRent.textContent = formatINR(Math.round(rent / 12));
    resPanStatus.textContent = rent > 100000 ? 'Required (> ₹1L)' : 'Not Required (≤ ₹1L)';

    rule1Val.textContent = formatINR(rule1);
    rule2Val.textContent = formatINR(rule2);
    rule2Formula.textContent = `${formatINR(rent)} - ${formatINR(tenPctBasic)} (10% of basic)`;
    rule3Val.textContent = formatINR(rule3);
    rule3Title.textContent = `${isMetro ? '50%' : '40%'} of Basic Salary (${isMetro ? 'Metro' : 'Non-Metro'})`;

    // Highlight winning rule
    box1.classList.remove('active-winner');
    box2.classList.remove('active-winner');
    box3.classList.remove('active-winner');

    if (exemptAmount === rule1) {
      box1.classList.add('active-winner');
      lowestRuleTag.textContent = `Condition 1 applies (lowest amount): Exempt HRA = ${formatINR(exemptAmount)}`;
    } else if (exemptAmount === rule2) {
      box2.classList.add('active-winner');
      lowestRuleTag.textContent = `Condition 2 applies (lowest amount): Exempt HRA = ${formatINR(exemptAmount)}`;
    } else {
      box3.classList.add('active-winner');
      lowestRuleTag.textContent = `Condition 3 applies (lowest amount): Exempt HRA = ${formatINR(exemptAmount)}`;
    }
  }

  [basicInput, receivedInput, rentInput].forEach((el) => el.addEventListener('input', runHraCalc));
  document.querySelectorAll('input[name="metro"]').forEach((el) => el.addEventListener('change', runHraCalc));
  calcBtn.addEventListener('click', runHraCalc);

  // Initial Run
  runHraCalc();
</script>
