      },
      {
        q: 'What is the current DA rate for central government employees?',
        a: 'The Dearness Allowance (DA) stands at 53% of basic pay as notified by the Department of Expenditure (effective July/October 2026 cycle).',
      },
    ],
  },
  {
    slug: '7th-cpc-pay-level-7',
    is8thCPCScenario: false,
    cpcTitle: '7th Central Pay Commission',
    levelTitle: 'Pay Level 7 (Entry Basic ₹44,900)',
    cpcLevel: 7,
    entryBasic: 44900,
    targetDesignations: 'Inspector of Central Excise/GST, Income Tax Inspector (ITI), Assistant Section Officer (ASO in CSS/MEA), CBI Sub-Inspector',
