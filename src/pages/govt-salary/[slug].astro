        projectedInHandX: 51200,
      },
      {
        factor: 2.86,
        label: 'Scenario C: 2.86x Staff Side NC-JCM Proposal',
        description: 'Simulates the high-demand proposal presented by central government employee federations.',
        revisedBasic: 51500,
        initialDA: 0,
