    summary: 'Hypothetical scenario simulator for 8th CPC Pay Level 1. Evaluates potential fitment factors (1.92x, 2.57x, 2.86x) against the current 7th CPC baseline.',
    eighthCpcScenarios: [
      {
        factor: 1.92,
        label: 'Scenario A: 1.92x Conservative Fitment',
        description: 'Assumes DA absorption (approx 53%) plus a modest ~25% real wage increase.',
        revisedBasic: 34600,
        initialDA: 0,
