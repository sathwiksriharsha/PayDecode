      },
    ],
  },
  {
    slug: '7th-cpc-pay-level-10',
    is8thCPCScenario: false,
    cpcTitle: '7th Central Pay Commission',
    levelTitle: 'Pay Level 10 (Entry Basic ₹56,100)',
