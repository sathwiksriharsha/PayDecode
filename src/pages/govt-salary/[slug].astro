---
/**
 * Government Pay Estimator Pages: /govt-salary/[slug]
 * 6 government pay estimators (3 verified 7th CPC levels and 3 hypothetical 8th CPC scenario models).
 * Clearly distinguishes official gazetted facts from editable assumptions and hypothetical scenarios.
 * Includes direct link to official commission portal: https://8cpc.gov.in/
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { formatINR } from '../../utils/formatCurrency';

interface GovtPayTrack {
  slug: string;
  is8thCPCScenario: boolean;
  cpcTitle: string;
  levelTitle: string;
  cpcLevel: number;
  entryBasic: number;
  targetDesignations: string;
  sourceDoc: string;
  sourceUrl: string;
  summary: string;
  // 7th CPC data
  seventhCpcData?: {
    daPercent: number;
    monthlyDA: number;
    hraX: number; // 30%
    hraY: number; // 20%
    hraZ: number; // 10%
    taHigher: number;
    taOther: number;
    npsDeduction: number; // 10% of Basic + DA
    cgegis: number;
    cghs: number;
  };
  // 8th CPC scenario models
  eighthCpcScenarios?: {
    factor: number;
    label: string;
    description: string;
    revisedBasic: number;
    initialDA: number;
    projectedHraX: number;
    projectedNps: number;
    projectedInHandX: number;
  }[];
  faqs: { q: string; a: string }[];
}

export const GOVT_PAY_TRACKS: GovtPayTrack[] = [
  // ─── 7th CPC Verified Pay Scales ───
  {
    slug: '7th-cpc-pay-level-1',
    is8thCPCScenario: false,
    cpcTitle: '7th Central Pay Commission',
    levelTitle: 'Pay Level 1 (Entry Basic ₹18,000)',
    cpcLevel: 1,
    entryBasic: 18000,
    targetDesignations: 'Multi-Tasking Staff (MTS), Group D, Peon, Track Maintainer, Helper, Daftary',
    sourceDoc: 'Gazette of India Notification No. 1-2/2016-IC (Ministry of Finance)',
    sourceUrl: 'https://doe.gov.in/7th-cpc-report',
