    seventhCpcData: {
      daPercent: 53,
      monthlyDA: 9540,
      hraX: 5400, // 30% or minimum ₹5,400
      hraY: 3600, // 20% or minimum ₹3,600
      hraZ: 1800, // 10% or minimum ₹1,800
      taHigher: 2066, // 1,350 + 53% DA on TA
      taOther: 1377,  // 900 + 53% DA on TA
