  .calc-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    padding: 0 0 var(--space-section);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .calc-layout {
      grid-template-columns: 1fr;
    }
  }

  .calc-inputs .card {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-lg));
  }

  @media (max-width: 1024px) {
    .calc-inputs .card {
      position: static;
    }
  }

  /* Breadcrumb */
  .breadcrumb {
    font-size: 13px;
    color: var(--color-muted);
