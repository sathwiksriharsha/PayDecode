  .advanced-section summary {
    font-size: 14px;
    font-weight: 600;
  }

  /* Monthly summary */
  .monthly-summary-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .summary-item {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    gap: var(--space-sm);
    align-items: center;
  }

  .summary-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--rounded-full);
  }

  /* Salary bar visualization */
  .salary-bar {
    display: flex;
    height: 12px;
    border-radius: var(--rounded-pill);
    overflow: hidden;
    background: var(--color-surface-strong);
  }

  .salary-bar-segment {
    height: 100%;
    transition: width var(--transition-slow);
  }

  /* Assumptions list */
  .assumptions-list {
    list-style: none;
    padding: 0;
  }

  .assumptions-list li {
    font-size: 13px;
    color: var(--color-muted);
    padding: 4px 0;
    padding-left: 16px;
    position: relative;
  }

  .assumptions-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-muted-soft);
  }

  /* SEO content */
  .seo-content p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
    margin-bottom: var(--space-base);
  }

  .seo-content ul {
    padding-left: var(--space-lg);
    margin-bottom: var(--space-base);
  }

  .seo-content li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
    margin-bottom: var(--space-xs);
  }

  /* ─── Simulated Payslip Styles ─── */
  .payslip-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 11, 13, 0.75);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .payslip-modal-content {
    background: var(--color-canvas);
    border-radius: var(--rounded-lg);
    max-width: 720px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: var(--space-lg);
    box-shadow: var(--shadow-elevated);
  }

  .payslip-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .printable-payslip {
    background: #ffffff;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: var(--space-lg);
    color: #0a0b0d;
  }

  .payslip-watermark {
    background: rgba(0, 82, 255, 0.08);
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-align: center;
    padding: 6px;
    border-radius: var(--rounded-xs);
    margin-bottom: var(--space-md);
  }

  .payslip-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--color-hairline);
    margin-bottom: var(--space-md);
  }

  .payslip-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .payslip-logo {
    width: 36px;
    height: 36px;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--rounded-sm);
  }

  .payslip-title {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .payslip-employee-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    background: var(--color-surface-soft);
    padding: var(--space-sm);
    border-radius: var(--rounded-sm);
    margin-bottom: var(--space-md);
    font-size: 12px;
  }

  .payslip-tables-grid {
    display: grid;
