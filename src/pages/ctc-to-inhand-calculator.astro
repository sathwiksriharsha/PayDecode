  }

  @media print {
    body * {
      visibility: hidden !important;
    }
    #printable-payslip, #printable-payslip * {
      visibility: visible !important;
    }
    #printable-payslip {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      box-shadow: none !important;
      border: 1px solid #dee1e6 !important;
    }
    .payslip-modal {
      position: static !important;
      background: none !important;
      padding: 0 !important;
    }
    .payslip-modal-header, .payslip-actions, .nav, .footer {
      display: none !important;
    }
  }

  .benchmarks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  @media (max-width: 900px) {
    .benchmarks-grid {
      grid-template-columns: 1fr;
    }
  }

  .benchmarks-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .benchmark-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    text-decoration: none;
    color: var(--color-body-strong);
    transition: all var(--transition-fast);
  }

  .benchmark-item:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    transform: translateX(3px);
  }
</style>

<script>
  /**
   * CTC Calculator — main interactive logic.
   */
  import { calculateSalary, type SalaryInput } from '../utils/salaryEngine';
  import { parseSalaryInput, formatINR, numberToIndianWords } from '../utils/formatCurrency';
  import type { PfPolicy } from '../config/statutoryRules';

  // ─── DOM Elements ───
  const ctcInput = document.getElementById('ctc-input') as HTMLInputElement;
  const pfSelect = document.getElementById('pf-policy') as HTMLSelectElement;
  const ptSelect = document.getElementById('pt-state') as HTMLSelectElement;
  const calcBtn = document.getElementById('calculate-btn') as HTMLButtonElement;
  const basicCustom = document.getElementById('basic-custom') as HTMLInputElement;

  // Variable pay
  const variableInput = document.getElementById('variable-pay') as HTMLInputElement;
  const payoutInput = document.getElementById('variable-payout') as HTMLInputElement;
  const joiningInput = document.getElementById('joining-bonus') as HTMLInputElement;

  // Employer NPS
  const npsInput = document.getElementById('employer-nps') as HTMLInputElement;

  // Old regime
  const rentInput = document.getElementById('rent-paid') as HTMLInputElement;
  const deduction80c = document.getElementById('deduction-80c') as HTMLInputElement;
  const deduction80d = document.getElementById('deduction-80d') as HTMLInputElement;
  const deduction80dParents = document.getElementById('deduction-80d-parents') as HTMLInputElement;
  const homeLoan = document.getElementById('home-loan') as HTMLInputElement;

  // Result elements
  const resultMonthly = document.getElementById('result-monthly')!;
  const resultAnnual = document.getElementById('result-annual-inhand')!;
  const summaryInhand = document.getElementById('summary-inhand')!;
  const summaryTax = document.getElementById('summary-tax')!;
  const summaryPf = document.getElementById('summary-pf')!;
  const summaryPt = document.getElementById('summary-pt')!;
  const barInhand = document.getElementById('bar-inhand')!;
  const barTax = document.getElementById('bar-tax')!;
  const barPf = document.getElementById('bar-pf')!;
  const barPt = document.getElementById('bar-pt')!;
  const ctcBody = document.getElementById('ctc-breakdown-body')!;
  const taxBody = document.getElementById('tax-breakdown-body')!;
  const slabBody = document.getElementById('slab-breakdown-body')!;
  const assumptionsList = document.getElementById('assumptions-list')!;
  const oldRegimePanel = document.getElementById('old-regime-deductions')!;

  // ─── State ───
  let currentRegime: 'new' | 'old' = 'new';

  // Regime tabs
  document.querySelectorAll('#regime-tabs .tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#regime-tabs .tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      currentRegime = (tab as HTMLElement).dataset.regime as 'new' | 'old';
      oldRegimePanel.style.display = currentRegime === 'old' ? 'block' : 'none';
      runCalculation();
    });
  });

  // ─── Get Basic Percent ───
  function getBasicPercent(): number {
    const checked = document.querySelector('input[name="basic-percent"]:checked') as HTMLInputElement;
    if (!checked) return 40;
    if (checked.value === 'custom') {
      return parseFloat(basicCustom?.value || '40') || 40;
    }
    return parseFloat(checked.value);
  }

  // ─── Get Metro ───
  function getIsMetro(): boolean {
    const checked = document.querySelector('input[name="metro"]:checked') as HTMLInputElement;
    return checked?.value === 'true';
  }

  // ─── Run Calculation ───
  function runCalculation() {
    const ctcValue = parseSalaryInput(ctcInput.value);
    if (!ctcValue || ctcValue <= 0) return;

    const input: SalaryInput = {
      annualCTC: ctcValue,
      basicPercent: getBasicPercent(),
      pfPolicy: pfSelect.value as PfPolicy,
      regime: currentRegime,
      professionalTaxState: ptSelect.value,
      targetVariablePay: parseSalaryInput(variableInput?.value || '') || 0,
      variablePayoutPercent: parseFloat(payoutInput?.value || '100') || 100,
      joiningBonus: parseSalaryInput(joiningInput?.value || '') || 0,
      employerNPS: parseSalaryInput(npsInput?.value || '') || 0,
      isMetro: getIsMetro(),
      rentPaid: parseSalaryInput(rentInput?.value || '') || 0,
      deduction80C: parseSalaryInput(deduction80c?.value || '') || 0,
      deduction80D_self: parseSalaryInput(deduction80d?.value || '') || 0,
      deduction80D_parents: parseSalaryInput(deduction80dParents?.value || '') || 0,
      homeLoanInterest: parseSalaryInput(homeLoan?.value || '') || 0,
    };

    const result = calculateSalary(input);

    // ─── Update Result Card ───
    resultMonthly.textContent = formatINR(result.monthlyInHand);
    resultAnnual.textContent = formatINR(result.annualInHand);

    // ─── Update Monthly Summary ───
    summaryInhand.textContent = formatINR(result.monthlyInHand);
    summaryTax.textContent = formatINR(result.tax.monthlyTDS);
    summaryPf.textContent = formatINR(result.monthlyEmployeePF);
    summaryPt.textContent = formatINR(result.monthlyProfessionalTax);

    // ─── Update Salary Bar ───
    const monthlyGross = result.monthlyFixedCash;
    if (monthlyGross > 0) {
      barInhand.style.width = `${(result.monthlyInHand / monthlyGross) * 100}%`;
      barTax.style.width = `${(result.tax.monthlyTDS / monthlyGross) * 100}%`;
      barPf.style.width = `${(result.monthlyEmployeePF / monthlyGross) * 100}%`;
      barPt.style.width = `${(result.monthlyProfessionalTax / monthlyGross) * 100}%`;
    }

    // ─── CTC Decomposition Table ───
    const ctcRows = [
      { label: 'Annual CTC', value: result.annualCTC, cls: 'subtotal' },
      { label: 'Basic Salary', value: result.annualBasic },
      { label: 'HRA', value: result.annualHRA },
      { label: 'Special Allowance', value: result.annualSpecialAllowance },
      ...(result.targetVariablePay > 0 ? [{ label: 'Target Variable Pay', value: result.targetVariablePay }] : []),
      ...(result.joiningBonus > 0 ? [{ label: 'Joining Bonus', value: result.joiningBonus }] : []),
      { label: 'Employer PF', value: result.employerPF.annualEmployerPF, cls: 'indent' },
      { label: 'Gratuity Accrual', value: result.gratuity.annualAccrual, cls: 'indent' },
      ...(result.employerNPS > 0 ? [{ label: 'Employer NPS', value: result.employerNPS, cls: 'indent' }] : []),
      { label: 'Fixed Cash Salary', value: result.annualFixedCash, cls: 'subtotal' },
      { label: 'Employee PF', value: -result.employeePF, cls: 'deduction' },
      { label: 'Professional Tax', value: -result.professionalTax, cls: 'deduction' },
      { label: 'Income Tax', value: -result.tax.totalTax, cls: 'deduction' },
      { label: 'Annual In-Hand', value: result.annualInHand, cls: 'total' },
    ];

    ctcBody.innerHTML = ctcRows
      .map(
        (r) =>
          `<tr class="${(r as any).cls || ''}">
            <td class="${(r as any).cls === 'indent' ? 'indent' : ''}">${r.label}</td>
            <td>${r.value < 0 ? `<span class="text-down">${formatINR(Math.abs(r.value))}</span>` : formatINR(r.value)}</td>
          </tr>`
      )
      .join('');

    // ─── Tax Breakdown Table ───
    const taxRows = [
      { label: 'Gross Salary', value: result.tax.grossSalary },
      { label: 'Standard Deduction', value: -result.tax.standardDeduction, cls: 'deduction' },
      ...(result.tax.professionalTaxDeduction > 0 ? [{ label: 'Professional Tax', value: -result.tax.professionalTaxDeduction, cls: 'deduction' }] : []),
      ...(result.tax.employerNPSDeduction > 0 ? [{ label: 'Employer NPS (Sec 124)', value: -result.tax.employerNPSDeduction, cls: 'deduction' }] : []),
      ...(result.tax.hraExemption > 0 ? [{ label: 'HRA Exemption', value: -result.tax.hraExemption, cls: 'deduction' }] : []),
      ...(result.tax.chapterVIADeductions > 0 ? [{ label: 'Chapter VI-A Deductions', value: -result.tax.chapterVIADeductions, cls: 'deduction' }] : []),
      ...(result.tax.homeLoanDeduction > 0 ? [{ label: 'Home Loan Interest (Sec 24)', value: -result.tax.homeLoanDeduction, cls: 'deduction' }] : []),
      { label: 'Taxable Income', value: result.tax.taxableIncome, cls: 'subtotal' },
      { label: 'Tax on Slabs', value: result.tax.slabTax },
      ...(result.tax.rebate > 0 ? [{ label: 'Rebate (Sec 156)', value: -result.tax.rebate, cls: 'deduction' }] : []),
      { label: 'Tax after Rebate', value: result.tax.taxAfterRebate },
      ...(result.tax.surcharge > 0 ? [{ label: 'Surcharge', value: result.tax.surcharge }] : []),
      { label: `Cess (4%)`, value: result.tax.cess },
      { label: 'Total Annual Tax', value: result.tax.totalTax, cls: 'total' },
      { label: 'Monthly TDS (estimate)', value: result.tax.monthlyTDS, cls: 'subtotal' },
    ];

    taxBody.innerHTML = taxRows
      .map(
        (r) =>
          `<tr class="${(r as any).cls || ''}">
            <td>${r.label}</td>
            <td>${r.value < 0 ? `<span class="text-down">${formatINR(Math.abs(r.value))}</span>` : formatINR(r.value)}</td>
          </tr>`
      )
      .join('');

    // ─── Slab Breakdown ───
    slabBody.innerHTML = result.tax.slabBreakdown
      .map(
        (s) =>
          `<tr>
            <td>${s.slab}</td>
            <td class="text-right">${(s.rate * 100).toFixed(0)}%</td>
            <td class="text-right font-mono">${formatINR(s.tax)}</td>
          </tr>`
      )
      .join('');

    // ─── Assumptions ───
    assumptionsList.innerHTML = result.assumptions
      .map((a) => `<li>${a}</li>`)
      .join('');

    // ─── Update Simulated Payslip ───
    const psCtc = document.getElementById('ps-ctc');
    const psRegime = document.getElementById('ps-regime');
    const psNetAmount = document.getElementById('ps-net-amount');
    const psNetWords = document.getElementById('ps-net-words');
    const psEarningsTbody = document.getElementById('ps-earnings-tbody');
    const psDeductionsTbody = document.getElementById('ps-deductions-tbody');

    if (psCtc) psCtc.textContent = formatINR(result.annualCTC);
    if (psRegime) psRegime.textContent = result.tax.regime === 'new' ? 'New Regime (Sec 202)' : 'Old Regime';
    if (psNetAmount) psNetAmount.textContent = formatINR(result.monthlyInHand);
    if (psNetWords) psNetWords.textContent = `approx ${numberToIndianWords(result.monthlyInHand)} Rupees`;

    if (psEarningsTbody) {
      psEarningsTbody.innerHTML = `
        <tr><td>Basic Salary</td><td class="text-right font-mono">${formatINR(result.monthlyBasic)}</td></tr>
        <tr><td>House Rent Allowance (HRA)</td><td class="text-right font-mono">${formatINR(Math.round(result.annualHRA / 12))}</td></tr>
        <tr><td>Special Allowance</td><td class="text-right font-mono">${formatINR(Math.round(result.annualSpecialAllowance / 12))}</td></tr>
        <tr style="font-weight:700; border-top:1px solid #dee1e6;"><td>Monthly Gross Earnings</td><td class="text-right font-mono">${formatINR(result.monthlyFixedCash)}</td></tr>
      `;
    }

    if (psDeductionsTbody) {
      psDeductionsTbody.innerHTML = `
        <tr><td>Employee Provident Fund (EPF)</td><td class="text-right font-mono">${formatINR(result.monthlyEmployeePF)}</td></tr>
        <tr><td>Professional Tax (PT)</td><td class="text-right font-mono">${formatINR(result.monthlyProfessionalTax)}</td></tr>
        <tr><td>Income Tax (Monthly TDS)</td><td class="text-right font-mono">${formatINR(result.tax.monthlyTDS)}</td></tr>
        <tr style="font-weight:700; border-top:1px solid #dee1e6;"><td>Total Monthly Deductions</td><td class="text-right font-mono">${formatINR(result.monthlyEmployeePF + result.monthlyProfessionalTax + result.tax.monthlyTDS)}</td></tr>
      `;
    }

    // Scroll to results on mobile
    if (window.innerWidth < 1024) {
      document.getElementById('result-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // ─── Payslip Modal Handlers ───
  const printPayslipBtn = document.getElementById('print-payslip-btn');
  const closePayslipBtn = document.getElementById('close-payslip-btn');
  const triggerPrintBtn = document.getElementById('trigger-print-btn');
  const payslipModal = document.getElementById('simulated-payslip-modal');

  printPayslipBtn?.addEventListener('click', () => {
    if (payslipModal) payslipModal.style.display = 'flex';
  });

  closePayslipBtn?.addEventListener('click', () => {
    if (payslipModal) payslipModal.style.display = 'none';
  });

  triggerPrintBtn?.addEventListener('click', () => {
    window.print();
  });

  // Close modal when clicking outside content
  payslipModal?.addEventListener('click', (e) => {
    if (e.target === payslipModal) {
      payslipModal.style.display = 'none';
    }
  });

  // ─── Event Listeners ───
  calcBtn.addEventListener('click', runCalculation);
  ctcInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') runCalculation(); });

  // Slider & Preset Chips Listeners
  const ctcSlider = document.getElementById('ctc-slider') as HTMLInputElement;
  const presetChips = document.querySelectorAll('#ctc-preset-chips .preset-chip');

  ctcSlider?.addEventListener('input', () => {
    ctcInput.value = ctcSlider.value;
    presetChips.forEach((c) => c.classList.remove('active'));
    runCalculation();
  });

  presetChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const val = chip.getAttribute('data-val');
      if (val) {
        ctcInput.value = val;
        if (ctcSlider) ctcSlider.value = val;
        presetChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        runCalculation();
      }
    });
  });

  ctcInput.addEventListener('input', () => {
    const parsed = parseSalaryInput(ctcInput.value);
    if (parsed && ctcSlider) {
      ctcSlider.value = String(parsed);
    }
  });

  // Auto-calculate on any input change
  [pfSelect, ptSelect].forEach((el) => el?.addEventListener('change', runCalculation));
  document.querySelectorAll('input[name="basic-percent"]').forEach((el) => el.addEventListener('change', runCalculation));
  document.querySelectorAll('input[name="metro"]').forEach((el) => el.addEventListener('change', runCalculation));

  // Run initial calculation
  runCalculation();
</script>
