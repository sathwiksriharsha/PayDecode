              </div>
              <div class="text-right">
                <span class="badge badge-success">Verified 7th CPC</span>
                <span class="caption text-success d-block">₹44.9K Basic + 53% DA</span>
              </div>
            </a>
            <a href="/govt-salary/7th-cpc-pay-level-10" class="benchmark-item">
              <div>
                <strong>7th CPC Pay Level 10</strong>
                <span class="caption text-muted d-block">Group A Officers, UPSC CSE</span>
              </div>
              <div class="text-right">
                <span class="badge badge-success">Verified 7th CPC</span>
                <span class="caption text-success d-block">₹56.1K Basic + 53% DA</span>
              </div>
            </a>
            <a href="/govt-salary/8th-cpc-fitment-scenario-level-1" class="benchmark-item">
              <div>
                <strong>8th CPC Level 1 Scenario</strong>
                <span class="caption text-muted d-block">1.92x to 2.86x Fitment Simulations</span>
              </div>
              <div class="text-right">
                <span class="badge badge-accent">Hypothetical</span>
                <span class="caption text-primary d-block">Proj. Basic ₹34.6K–₹51.5K</span>
              </div>
            </a>
            <a href="/govt-salary/8th-cpc-fitment-scenario-level-7" class="benchmark-item">
              <div>
                <strong>8th CPC Level 7 Scenario</strong>
                <span class="caption text-muted d-block">ASO & Inspector Projections</span>
              </div>
