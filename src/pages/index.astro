---
/**
 * Homepage — PayDecode
 * Primary landing page with inline CTC calculator, feature grid, and SEO content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { RULES_METADATA } from '../config/statutoryRules';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: site.name,
  description: site.description,
  url: site.url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
  },
};
---

<BaseLayout
  title={site.tagline}
  description={site.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>

  <!-- ═══ Hero Band (Dark) ═══ -->
  <section class="hero-dark">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <span class="badge badge-primary mb-base">Tax Year 2026–27 • Updated Oct 2026</span>
          <h1 class="display-mega mb-lg">
            Decode Your<br />
            <span class="hero-gradient">Real Salary</span>
          </h1>
          <p class="hero-subtitle mb-xl">
            India's most transparent CTC-to-in-hand calculator. Understand why two offers
            with the same headline CTC can produce different take-home pay.
          </p>
          <div class="hero-ctas">
            <a href="/ctc-to-inhand-calculator" class="btn btn-pill-cta" id="hero-cta-calculator">
              Calculate Now
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 10h10M11 6l4 4-4 4"/>
              </svg>
            </a>
            <a href="/methodology" class="btn btn-outline-dark" id="hero-cta-methodology">
              How it works
            </a>
          </div>
        </div>

        <!-- Quick Calculator Card -->
        <div class="hero-card-stack">
          <div class="quick-calc-card" id="quick-calc">
            <div class="quick-calc-header">
              <span class="title-sm" style="color: var(--color-on-dark);">Quick Estimate</span>
              <span class="caption" style="color: var(--color-on-dark-soft);">New Regime</span>
            </div>

            <div class="input-group">
              <label for="hero-ctc-input" class="input-label" style="color: var(--color-on-dark-soft);">Annual CTC</label>
              <div class="input-with-prefix">
                <span class="input-prefix" style="color: var(--color-on-dark-soft);">₹</span>
                <input
                  type="text"
                  id="hero-ctc-input"
                  class="input input-number input-dark"
                  placeholder="e.g. 12,00,000 or 12L"
                  inputmode="decimal"
                  autocomplete="off"
                  value="1200000"
                />
              </div>
              <div class="preset-chips preset-chips-dark mt-xs" id="hero-preset-chips">
                <button type="button" class="preset-chip" data-val="600000">6L</button>
                <button type="button" class="preset-chip active" data-val="1200000">12L</button>
                <button type="button" class="preset-chip" data-val="1800000">18L</button>
                <button type="button" class="preset-chip" data-val="2500000">25L</button>
                <button type="button" class="preset-chip" data-val="5000000">50L</button>
              </div>
            </div>

            <div class="quick-result" id="quick-result" style="display: block;">
              <div class="quick-result-row">
                <span style="color: var(--color-on-dark-soft);">Monthly In-Hand</span>
                <span class="number-large" id="quick-monthly" style="color: #34d399;">₹91,869</span>
              </div>
              <div class="quick-result-row" style="margin-top: 8px;">
                <span style="color: var(--color-on-dark-soft);">Annual Income Tax</span>
                <span class="number-display" id="quick-tax" style="color: #60a5fa;">₹0 (Sec 156 Rebate)</span>
              </div>
              <a href="/ctc-to-inhand-calculator" class="btn btn-primary mt-base" style="width:100%" id="quick-detailed-link">
                See full breakdown & payslip →
              </a>
            </div>

            <p class="caption mt-sm" style="color: var(--color-on-dark-soft);">
              Estimate based on default assumptions. <a href="/methodology" style="color: var(--color-primary);">See methodology</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Trust Bar ═══ -->
  <section class="band-soft" style="padding: var(--space-xl) 0;">
    <div class="container">
      <div class="trust-bar">
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-semantic-up)" stroke-width="2"><path d="M17 5L8 14l-4-4"/></svg>
          <span>100% Client-Side</span>
        </div>
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-semantic-up)" stroke-width="2"><path d="M17 5L8 14l-4-4"/></svg>
          <span>No Data Uploaded</span>
        </div>
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-semantic-up)" stroke-width="2"><path d="M17 5L8 14l-4-4"/></svg>
          <span>IT Act 2025 Updated</span>
        </div>
        <div class="trust-item">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="var(--color-semantic-up)" stroke-width="2"><path d="M17 5L8 14l-4-4"/></svg>
          <span>PF ₹25K Ceiling (Sep 2026)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Features Grid (Image 1 Aesthetic applied to Image 2) ═══ -->
  <section class="section-showcase-flow">
    <div class="container">
      <div class="showcase-outer-box">
        <div class="showcase-box-header">
          <div class="showcase-eyebrow">// ESSENTIAL SALARY TOOLKIT</div>
          <h2 class="showcase-heading">Every tool you need to understand your salary</h2>
          <p class="showcase-subheading">
            From CTC breakdown to tax regime comparison — all calculations are transparent,
            editable, and based on linked official sources.
          </p>
        </div>

        <div class="showcase-cards-grid">
          <a href="/ctc-to-inhand-calculator" class="showcase-item-card" id="feature-ctc">
            <div class="card-num-circle">1</div>
            <h3 class="card-heading">CTC to In-Hand Calculator</h3>
            <p class="card-text">Decode your offer letter. See exactly where every rupee of your CTC goes — basic, PF, gratuity, tax, and what lands in your bank.</p>
          </a>

          <a href="/inhand-to-ctc-calculator" class="showcase-item-card" id="feature-reverse">
            <div class="card-num-circle">2</div>
            <h3 class="card-heading">In-Hand to CTC Calculator</h3>
            <p class="card-text">Want ₹1L/month in hand? Find out what CTC you need. Reverse-solves using the same full calculation engine.</p>
          </a>

          <a href="/offer-comparison-calculator" class="showcase-item-card" id="feature-compare">
            <div class="card-num-circle">3</div>
            <h3 class="card-heading">Offer Comparison</h3>
            <p class="card-text">Compare two offers with independent assumptions. See the real in-hand difference, not just headline CTC.</p>
          </a>

          <a href="/new-vs-old-tax-regime-calculator" class="showcase-item-card" id="feature-regime">
            <div class="card-num-circle">4</div>
            <h3 class="card-heading">New vs Old Tax Regime</h3>
            <p class="card-text">Which tax regime saves you more? Compare with your actual deductions under the Income-tax Act, 2025.</p>
          </a>

          <a href="/salary-hike-calculator" class="showcase-item-card" id="feature-hike">
            <div class="card-num-circle">5</div>
            <h3 class="card-heading">Salary Hike Calculator</h3>
            <p class="card-text">A 30% CTC hike doesn't mean 30% more in-hand. See the actual post-tax change in your bank credit.</p>
          </a>

          <a href="/hra-exemption-calculator" class="showcase-item-card" id="feature-hra">
            <div class="card-num-circle">6</div>
            <h3 class="card-heading">HRA Exemption Calculator</h3>
            <p class="card-text">Estimate your House Rent Allowance tax exemption under the old regime. Metro vs non-metro, with clear eligibility rules.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Quick Offer Comparison Section (Single Line) ═══ -->
  <section class="band-soft" id="compare-offers-home" style="padding: var(--space-xxl) 0;">
    <div class="container">
      <div class="text-center mb-xl">
        <div class="badge badge-accent mb-xs">Offer Showdown</div>
        <h2 class="display-sm mb-xs">Compare Two Offers in a Single Line</h2>
        <p class="body-md text-muted" style="max-width: 600px; margin: 0 auto;">
          Two offers with different headline CTCs can have counter-intuitive take-home numbers. See why guaranteed fixed cash beats volatile bonuses.
        </p>
      </div>

      <!-- Single-Line Scoreboard -->
      <div class="card-scoreboard mb-lg">
        <div class="scoreboard-row">
          <!-- Offer A Column -->
          <div class="scoreboard-col scoreboard-col-a">
            <div class="scoreboard-badge-a">
              <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#60a5fa;"></span>
              <span>Offer A (Fixed-Heavy)</span>
            </div>
            <div class="scoreboard-val">₹1,13,288</div>
            <div class="scoreboard-sub">Monthly Take-Home</div>
            <div class="scoreboard-ctc">₹18 Lakh CTC (100% Fixed Cash)</div>
          </div>

          <!-- VS Column -->
          <div class="scoreboard-vs">
            <div class="vs-pill">VS</div>
            <div>
              <span class="scoreboard-delta-badge">+₹19,073 / mo</span>
            </div>
            <div class="scoreboard-delta-winner">Offer A Leads Take-Home</div>
          </div>

          <!-- Offer B Column -->
          <div class="scoreboard-col scoreboard-col-b">
            <div class="scoreboard-badge-b">
              <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#34d399;"></span>
              <span>Offer B (Bonus-Heavy)</span>
            </div>
            <div class="scoreboard-val">₹94,215</div>
            <div class="scoreboard-sub">Monthly Take-Home</div>
            <div class="scoreboard-ctc">₹20 Lakh CTC (Includes ₹4.5L Bonus)</div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/offer-comparison-calculator" class="btn btn-primary" id="home-compare-cta">
          Compare Your Own Offers Head-to-Head →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ How It Works (Image 1 3-Step Flow Aesthetic) ═══ -->
  <section class="section-showcase-flow">
    <div class="container">
      <div class="showcase-outer-box">
        <div class="showcase-box-header">
          <div class="showcase-eyebrow">// SIMPLE 3-STEP FLOW</div>
          <h2 class="showcase-heading">How PayDecode Works</h2>
          <p class="showcase-subheading">
            Engineered to remove all guesswork from Indian compensation structures and payslips.
          </p>
        </div>

        <div class="showcase-steps-grid">
          <div class="showcase-item-card">
            <div class="card-num-circle">1</div>
            <h3 class="card-heading">Enter Your CTC & Offer</h3>
            <p class="card-text">Type your annual CTC or offer amount. Supports plain numbers, lakhs (12L), or crores with instant client-side parsing.</p>
          </div>

          <div class="showcase-item-card">
            <div class="card-num-circle">2</div>
            <h3 class="card-heading">Adjust Assumptions</h3>
            <p class="card-text">Set your basic pay ratio, PF policy (statutory ceiling vs full basic), tax regime, state professional tax, and variable pay.</p>
          </div>

          <div class="showcase-item-card">
            <div class="card-num-circle">3</div>
            <h3 class="card-heading">Decode Real Take-Home</h3>
            <p class="card-text">Get a line-by-line breakdown of your monthly bank credit, tax, PF, and every CTC component. Download an audited payslip preview.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Why PayDecode ═══ -->
  <section class="hero-light">
    <div class="container">
      <div class="why-grid">
        <div class="why-text">
          <h2 class="display-md mb-lg">Why this may differ from your payslip</h2>
          <p class="body-md text-body mb-lg">
            Every salary calculator is an estimate. Your actual payslip depends on your employer's
            specific salary structure, PF policy, payroll software, state professional tax, variable
            pay timing, and other factors we can't know.
          </p>
          <p class="body-md text-body mb-lg">
            PayDecode is transparent about this. We show you every assumption, link to official
            sources, and let you adjust inputs to match your situation.
          </p>
          <div class="why-list">
            <div class="why-item">
              <span class="why-bullet">→</span>
              <span>Employer salary structure and basic-pay ratio vary</span>
            </div>
            <div class="why-item">
              <span class="why-bullet">→</span>
              <span>PF can be on statutory ceiling, full basic, or custom</span>
            </div>
            <div class="why-item">
              <span class="why-bullet">→</span>
              <span>Professional tax varies by state</span>
            </div>
            <div class="why-item">
              <span class="why-bullet">→</span>
              <span>Variable pay timing and payout percentage affect TDS</span>
            </div>
            <div class="why-item">
              <span class="why-bullet">→</span>
              <span>Tax regime choice and personal deductions change the answer</span>
            </div>
          </div>
        </div>
        <div class="why-card-stack">
          <div class="card" style="padding: var(--space-lg);">
            <h3 class="title-sm mb-sm">Sources & Rules</h3>
            <div class="source-list">
              {RULES_METADATA.sources.map((s) => (
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-link">
                  <span>{s.label}</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 2h7v7M12 2L2 12"/></svg>
                </a>
              ))}
            </div>
            <p class="caption mt-base">
              Rules last reviewed: {RULES_METADATA.rulesLastReviewed}. Tax Year {RULES_METADATA.taxYear}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Company Packages & Government Pay Scales ═══ -->
  <section class="band-soft" id="benchmarks">
    <div class="container">
      <div class="text-center mb-xl">
        <div class="badge badge-primary mb-xs">Phase 2 Benchmarks</div>
        <h2 class="display-md mb-base">Explore Real Offers & Pay Commission Scales</h2>
        <p class="body-md text-muted" style="max-width: 650px; margin: 0 auto;">
          Verified offer breakdowns from top Indian tech employers and official Central Pay Commission salary scales.
        </p>
      </div>

      <div class="benchmarks-grid">
        <!-- Top Company Packages -->
        <div class="card p-xl">
          <div class="card-header-flex mb-md">
            <div>
              <h3 class="title-md mb-xxs">Corporate Tech Offer Breakdowns</h3>
              <p class="caption text-muted">Verified CTC structures with monthly bank credit analysis</p>
            </div>
            <span class="badge badge-accent">8 Top Tracks</span>
          </div>

          <div class="benchmarks-list">
            <a href="/company/tcs-ninja" class="benchmark-item">
              <div>
                <strong>TCS Ninja</strong>
                <span class="caption text-muted d-block">Graduate Trainee / ASE-T</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹3.36 LPA</span>
                <span class="caption text-success d-block">~₹22.5K/mo take-home</span>
              </div>
            </a>
            <a href="/company/tcs-digital" class="benchmark-item">
              <div>
                <strong>TCS Digital</strong>
                <span class="caption text-muted d-block">Systems Engineer Digital</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹7.0 LPA</span>
                <span class="caption text-success d-block">~₹48K/mo take-home</span>
              </div>
            </a>
            <a href="/company/tcs-prime" class="benchmark-item">
              <div>
                <strong>TCS Prime</strong>
                <span class="caption text-muted d-block">Senior Systems Engineer</span>
              </div>
              <div class="text-right">
