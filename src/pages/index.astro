                <span class="caption text-success d-block">~₹63K/mo take-home</span>
              </div>
            </a>
            <a href="/company/infosys-se" class="benchmark-item">
              <div>
                <strong>Infosys Systems Engineer</strong>
                <span class="caption text-muted d-block">Foundation Freshers Tier</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹3.6 LPA</span>
                <span class="caption text-success d-block">~₹23.5K/mo take-home</span>
              </div>
            </a>
            <a href="/company/infosys-sp" class="benchmark-item">
              <div>
                <strong>Infosys Specialist Programmer</strong>
                <span class="caption text-muted d-block">HackWithInfy Premier Cadre</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹9.5 LPA</span>
                <span class="caption text-success d-block">~₹65K/mo take-home</span>
              </div>
            </a>
            <a href="/company/wipro-turbo" class="benchmark-item">
              <div>
                <strong>Wipro Turbo</strong>
                <span class="caption text-muted d-block">Elite Project Engineer</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹6.5 LPA</span>
                <span class="caption text-success d-block">~₹45K/mo take-home</span>
              </div>
            </a>
            <a href="/company/accenture-ase" class="benchmark-item">
              <div>
                <strong>Accenture ASE</strong>
                <span class="caption text-muted d-block">Associate Software Engineer</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹4.5 LPA</span>
                <span class="caption text-success d-block">~₹31K/mo take-home</span>
              </div>
            </a>
            <a href="/company/cognizant-genc" class="benchmark-item">
