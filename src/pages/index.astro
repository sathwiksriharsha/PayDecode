<script>
  /**
   * Quick calculator on the homepage hero.
   * Uses the salary engine for instant estimates.
   */
  import { calculateSalary } from '../utils/salaryEngine';
  import { parseSalaryInput, formatINR } from '../utils/formatCurrency';

  const input = document.getElementById('hero-ctc-input') as HTMLInputElement;
  const resultDiv = document.getElementById('quick-result');
  const monthlyEl = document.getElementById('quick-monthly');
  const taxEl = document.getElementById('quick-tax');
  const detailedLink = document.getElementById('quick-detailed-link') as HTMLAnchorElement;

  if (input && resultDiv && monthlyEl && taxEl) {
    function updateHeroCalc(val: number) {
      try {
        const result = calculateSalary({
          annualCTC: val,
          basicPercent: 40,
          pfPolicy: 'statutory_ceiling',
          regime: 'new',
          professionalTaxState: 'maharashtra',
        });

        monthlyEl.textContent = formatINR(result.monthlyInHand);
        taxEl.textContent = result.tax.totalTax === 0 ? '₹0 (Sec 156 Rebate)' : `${formatINR(result.tax.totalTax)}/year`;
        resultDiv.style.display = 'block';
        resultDiv.classList.add('animate-fade-in');
      } catch {
        resultDiv.style.display = 'none';
      }
    }

    let debounceTimer: ReturnType<typeof setTimeout>;

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const value = parseSalaryInput(input.value);
        if (value && value > 0 && value <= 100_00_00_000) {
          updateHeroCalc(value);
        } else {
          resultDiv.style.display = 'none';
        }
      }, 200);
    });

    // Preset chips
    const heroChips = document.querySelectorAll('#hero-preset-chips .preset-chip');
    heroChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const val = chip.getAttribute('data-val');
        if (val) {
          input.value = val;
          heroChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          updateHeroCalc(Number(val));
        }
      });
    });
  }
</script>
