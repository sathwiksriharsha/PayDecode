                <strong>Cognizant GenC</strong>
                <span class="caption text-muted d-block">Programmer Analyst Trainee</span>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold">₹4.0 LPA</span>
                <span class="caption text-success d-block">~₹28K/mo take-home</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Government Pay Scales -->
        <div class="card p-xl">
          <div class="card-header-flex mb-md">
            <div>
              <h3 class="title-md mb-xxs">Government Pay Scales & Scenarios</h3>
              <p class="caption text-muted">7th CPC Gazette Pay & 8th CPC Scenario Models</p>
            </div>
            <span class="badge badge-primary">6 Pay Tracks</span>
          </div>

          <div class="benchmarks-list">
            <a href="/govt-salary/7th-cpc-pay-level-1" class="benchmark-item">
              <div>
                <strong>7th CPC Pay Level 1</strong>
