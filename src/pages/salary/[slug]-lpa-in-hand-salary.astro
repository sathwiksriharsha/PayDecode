---
/**
 * Programmatic Salary Breakdown Page: /salary/[slug]-lpa-in-hand-salary
 * Generates pre-rendered, rich editorial salary pages for popular LPA brackets.
 * Includes three-scenario PF comparison (statutory capped vs full-basic vs historical).
 * Fully compliant with Income-tax Act, 2025 (Tax Year 2026–27).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { calculateSalary } from '../../utils/salaryEngine';
import { formatINR, numberToIndianWords } from '../../utils/formatCurrency';

export async function getStaticPaths() {
  const lpaValues = [
    { lpa: 1.8, slug: '1-8' },
    { lpa: 2, slug: '2' },
    { lpa: 2.2, slug: '2-2' },
    { lpa: 2.4, slug: '2-4' },
    { lpa: 2.5, slug: '2-5' },
    { lpa: 2.6, slug: '2-6' },
    { lpa: 2.7, slug: '2-7' },
    { lpa: 2.8, slug: '2-8' },
    { lpa: 3, slug: '3' },
    { lpa: 3.2, slug: '3-2' },
    { lpa: 3.36, slug: '3-36' },
    { lpa: 3.5, slug: '3-5' },
    { lpa: 3.6, slug: '3-6' },
    { lpa: 3.8, slug: '3-8' },
    { lpa: 4, slug: '4' },
    { lpa: 4.2, slug: '4-2' },
    { lpa: 4.5, slug: '4-5' },
    { lpa: 4.8, slug: '4-8' },
    { lpa: 5, slug: '5' },
    { lpa: 5.2, slug: '5-2' },
    { lpa: 5.5, slug: '5-5' },
    { lpa: 6, slug: '6' },
    { lpa: 6.2, slug: '6-2' },
    { lpa: 6.5, slug: '6-5' },
    { lpa: 7, slug: '7' },
    { lpa: 7.2, slug: '7-2' },
    { lpa: 7.5, slug: '7-5' },
    { lpa: 8, slug: '8' },
    { lpa: 8.2, slug: '8-2' },
    { lpa: 8.5, slug: '8-5' },
    { lpa: 9, slug: '9' },
    { lpa: 9.5, slug: '9-5' },
    { lpa: 10, slug: '10' },
    { lpa: 10.5, slug: '10-5' },
    { lpa: 11, slug: '11' },
    { lpa: 11.5, slug: '11-5' },
    { lpa: 12, slug: '12' },
    { lpa: 12.5, slug: '12-5' },
    { lpa: 13, slug: '13' },
    { lpa: 13.5, slug: '13-5' },
    { lpa: 14, slug: '14' },
    { lpa: 14.5, slug: '14-5' },
    { lpa: 15, slug: '15' },
    { lpa: 16, slug: '16' },
    { lpa: 17, slug: '17' },
    { lpa: 18, slug: '18' },
    { lpa: 20, slug: '20' },
    { lpa: 22, slug: '22' },
    { lpa: 24, slug: '24' },
    { lpa: 25, slug: '25' },
    { lpa: 28, slug: '28' },
    { lpa: 30, slug: '30' },
    { lpa: 35, slug: '35' },
    { lpa: 40, slug: '40' },
    { lpa: 50, slug: '50' },
    { lpa: 60, slug: '60' },
    { lpa: 75, slug: '75' },
    { lpa: 100, slug: '100' },
  ];

  return lpaValues.map(({ lpa, slug }) => {
    const annualCTC = lpa * 100000;
    const monthlyBasic = (annualCTC * 0.4) / 12;

    // Scenario 1: Applicable Capped PF (Statutory ceiling ₹25,000/mo effective 17 Sep 2026)
    const breakdownNew = calculateSalary({
      annualCTC,
      basicPercent: 40,
      pfPolicy: 'statutory_ceiling',
      regime: 'new',
    });

    // Scenario 2: Full-Basic PF (Voluntary / corporate policy on uncapped basic under Para 26(6))
    const breakdownFull = calculateSalary({
      annualCTC,
      basicPercent: 40,
      pfPolicy: 'full_basic',
      regime: 'new',
    });

    // Scenario 3: Dated Historical PF (Pre-Sept 2026 statutory ceiling of ₹15,000/mo)
    const breakdownHistorical = calculateSalary({
      annualCTC,
      basicPercent: 40,
      pfPolicy: 'custom',
      customPfWage: Math.min(monthlyBasic, 15000),
      regime: 'new',
    });

    // Comparison with Old Tax Regime
    const breakdownOld = calculateSalary({
      annualCTC,
      basicPercent: 40,
      pfPolicy: 'statutory_ceiling',
      regime: 'old',
    });

    return {
      params: { slug },
      props: {
        lpa,
        slug,
        annualCTC,
        breakdownNew,
        breakdownFull,
        breakdownHistorical,
        breakdownOld,
      },
    };
  });
}

interface Props {
  lpa: number;
  slug: string;
  annualCTC: number;
  breakdownNew: ReturnType<typeof calculateSalary>;
  breakdownFull: ReturnType<typeof calculateSalary>;
  breakdownHistorical: ReturnType<typeof calculateSalary>;
  breakdownOld: ReturnType<typeof calculateSalary>;
}

const { lpa, slug, annualCTC, breakdownNew, breakdownFull, breakdownHistorical, breakdownOld } = Astro.props;

const title = `${lpa} LPA In-Hand Salary 2026–27 | Monthly Take-Home & Tax Breakdown`;
const description = `What is the in-hand salary for ${lpa} LPA CTC in 2026–27? Monthly bank credit is approx ${formatINR(breakdownNew.monthlyInHand)} under the New Tax Regime. Detailed PF, gratuity, and tax calculation.`;

const canonicalPath = `/salary/${slug}-lpa-in-hand-salary`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${lpa} LPA In-Hand Salary Breakdown — ${site.name}`,
  description,
  url: `${site.url}${canonicalPath}`,
  author: { '@type': 'Organization', name: site.name },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What does a ${lpa} LPA package mean in monthly salary?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `A ${lpa} LPA package equates to an average gross monthly CTC of ₹${Math.round((lpa * 100000) / 12).toLocaleString('en-IN')}/month. However, your actual take-home in-hand salary deposited in your bank account is approximately ${formatINR(breakdownNew.monthlyInHand)} per month under the standard statutory wage ceiling (₹25,000/mo), ${formatINR(breakdownFull.monthlyInHand)} per month under full-basic PF, or ${formatINR(breakdownHistorical.monthlyInHand)} per month under historical pre-Sept 2026 rules after deducting Employee PF (${formatINR(breakdownNew.monthlyEmployeePF)}/mo), state Professional Tax (₹200/mo), and Income Tax TDS under the New Tax Regime (Tax Year 2026–27).`,
      },
    },
    {
      '@type': 'Question',
      name: `What is the monthly in-hand salary for ${lpa} LPA?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `For an annual CTC of ${lpa} Lakh (₹${(lpa * 100000).toLocaleString('en-IN')}), your estimated monthly in-hand take-home salary is approximately ${formatINR(breakdownNew.monthlyInHand)} per month under the New Tax Regime (Tax Year 2026–27).`,
      },
    },
    {
      '@type': 'Question',
      name: `How much tax do I pay on ${lpa} LPA in 2026–27?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: breakdownNew.tax.totalTax === 0
          ? `You pay ₹0 in income tax on ${lpa} LPA CTC under the New Tax Regime! Because your taxable income after standard deduction is within the ₹12,00,000 threshold, you receive a 100% tax rebate under Section 156.`
          : `Under the New Tax Regime, your estimated annual income tax on ${lpa} LPA is approximately ${formatINR(breakdownNew.tax.totalTax)} (about ${formatINR(breakdownNew.tax.monthlyTDS)} per month TDS).`,
      },
    },
    {
      '@type': 'Question',
      name: `What is the EPF deduction for ${lpa} LPA?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `With the statutory wage ceiling set at ₹25,000/month (effective 17 September 2026), your employee PF deduction is ${formatINR(breakdownNew.monthlyEmployeePF)} per month (${formatINR(breakdownNew.employeePF)} annually), matched by an equal employer contribution.`,
      },
    },
  ],
};

const allLpas = [
  1.8, 2, 2.2, 2.4, 2.5, 2.6, 2.7, 2.8, 3, 3.2, 3.36, 3.5, 3.6, 3.8, 4, 4.2, 4.5, 4.8, 5, 5.2, 5.5,
  6, 6.2, 6.5, 7, 7.2, 7.5, 8, 8.2, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13, 13.5, 14, 14.5,
  15, 16, 17, 18, 20, 22, 24, 25, 28, 30, 35, 40, 50, 60, 75, 100
];
const nearbyLpas = allLpas.filter((n) => n !== lpa && Math.abs(n - lpa) <= (lpa <= 10 ? 3 : lpa <= 30 ? 6 : 15)).slice(0, 8);

// Eligibility calculations for Marginal Relief & Employer NPS:
// Calculate actual taxable income first; NEVER determine eligibility from CTC alone.
const taxableIncome = breakdownNew.tax.taxableIncome;
const slabTax = breakdownNew.tax.slabTax;
const rebate = breakdownNew.tax.rebate;
const isZeroTax = breakdownNew.tax.totalTax === 0;
// Section 156 Marginal relief triggers ONLY when taxable income exceeds ₹12,00,000
// AND slab tax > excess income over ₹12,00,000 (which leaves rebate > 0)
const isMarginalReliefEligible = taxableIncome > 1200000 && rebate > 0;
const excessIncomeOver12L = Math.max(0, taxableIncome - 1200000);

// Employer NPS (Section 124 / legacy 80CCD(2)):
const maxEmployerNPS = Math.round(breakdownNew.annualBasic * 0.14);
const taxableIncomeAfterNPS = Math.max(0, taxableIncome - maxEmployerNPS);
const topMarginalRate = taxableIncome > 2400000 ? 0.30 : taxableIncome > 2000000 ? 0.25 : taxableIncome > 1600000 ? 0.20 : taxableIncome > 1200000 ? 0.15 : taxableIncome > 800000 ? 0.10 : 0.05;
const estimatedNPSSavings = Math.round(maxEmployerNPS * topMarginalRate * 1.04);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Breadcrumb -->
  <div class="container mt-lg mb-lg">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/ctc-to-inhand-calculator">Calculators</a>
      <span class="breadcrumb-sep">›</span>
      <span>{lpa} LPA Salary</span>
    </nav>
  </div>

  <div class="container">
    <div class="calc-layout">

      <!-- ═══ Left: In-Hand Hero Card & Quick Specs ═══ -->
      <div class="calc-inputs">
        <div class="card card-hero-result">
          <div class="hero-result-header">
            <span class="hero-result-label">{lpa} Lakh Annual CTC</span>
            <span class="badge badge-success">New Regime 2026–27</span>
          </div>

          <div class="hero-result-amount text-success">{formatINR(breakdownNew.monthlyInHand)} / mo</div>
          <div class="hero-result-sub">
            Estimated monthly bank credit ({formatINR(breakdownNew.annualInHand)} annual take-home)
          </div>

          <div class="hero-stats-grid mt-lg">
            <div class="hero-stat-box">
              <span class="stat-caption">Annual CTC</span>
              <span class="stat-val font-mono">{formatINR(annualCTC)}</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Annual Income Tax</span>
              <span class="stat-val font-mono text-danger">{formatINR(breakdownNew.tax.totalTax)}</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Monthly Employee PF</span>
              <span class="stat-val font-mono">{formatINR(breakdownNew.monthlyEmployeePF)}</span>
            </div>
            <div class="hero-stat-box">
              <span class="stat-caption">Monthly Gross</span>
              <span class="stat-val font-mono">{formatINR(breakdownNew.monthlyGross)}</span>
            </div>
          </div>
        </div>

        <!-- Customizer CTA -->
        <div class="card mt-lg">
          <h3 class="title-sm mb-xs">Want to Customize Assumptions?</h3>
          <p class="body-sm text-muted mb-md">
            Do you have variable pay, joining bonus, employer NPS, or different PF policies? Adjust assumptions in our full calculator.
          </p>
          <a href="/ctc-to-inhand-calculator" class="btn btn-primary btn-block">
            Open Full Interactive CTC Decoder →
          </a>
        </div>

        <!-- Ad Slot -->
        <div class="ad-container-outer mt-lg">
          <div class="ad-label">Advertisement</div>
          <div class="ad-slot ad-responsive" id="ad-slot-lpa-1">
            <div class="ad-placeholder">
              <span>Salary Account Perks, Instant Overdraft & Zero Fee Credit Cards</span>
            </div>
          </div>
        </div>

        <!-- Related Salary Brackets -->
        <div class="card mt-lg bg-soft">
          <h3 class="title-sm mb-xs">Compare Nearby CTCs</h3>
          <div class="lpa-chips-grid mt-sm">
            {nearbyLpas.map((nearLpa) => {
              const nearSlug = String(nearLpa).replace('.', '-');
              return (
                <a href={`/salary/${nearSlug}-lpa-in-hand-salary`} class="lpa-link-chip">
                  {nearLpa} LPA
                </a>
              );
            })}
          </div>
        </div>

      </div>

      <!-- ═══ Right: Complete Line-by-Line Breakdown ═══ -->
      <div class="calc-results">

        <div class="card">
          <h1 class="display-sm mb-xs">{lpa} LPA In-Hand Salary Breakdown</h1>
          <p class="body-sm text-muted mb-lg">
            Detailed salary structure for ₹{(lpa * 100000).toLocaleString('en-IN')} annual CTC under the Income-tax Act, 2025.
          </p>

          <!-- Natural Search Phrasing Callout: [X] Package Means How Much Monthly Salary? -->
          <div class="package-means-callout mb-xl p-md bg-soft border rounded">
            <h2 class="title-sm mb-xs">What does a {lpa} LPA package mean in monthly salary?</h2>
            <p class="body-sm text-body mb-sm">
              If an employer offers a <strong>{lpa} LPA package</strong> ({numberToIndianWords(annualCTC)}), simple division gives a headline gross average of <strong>{formatINR(Math.round(annualCTC / 12))} per month</strong> (₹{(annualCTC / 12).toFixed(0)}/mo).
              However, your actual monthly in-hand bank credit is lower because Cost-to-Company (CTC) includes employer retiral overheads and requires statutory deductions:
            </p>
            <div class="grid-stats-4 mb-sm">
              <div class="stat-card p-xs bg-canvas border rounded">
                <div class="caption text-muted">Gross Monthly CTC</div>
                <div class="font-mono text-body font-bold">{formatINR(Math.round(annualCTC / 12))} / mo</div>
                <div class="caption text-muted mt-xxs">₹{annualCTC.toLocaleString('en-IN')} ÷ 12</div>
              </div>
              <div class="stat-card p-xs bg-canvas border rounded border-primary">
                <div class="caption text-primary">In-Hand (Statutory Capped PF)</div>
                <div class="font-mono text-success font-bold">{formatINR(breakdownNew.monthlyInHand)} / mo</div>
                <div class="caption text-muted mt-xxs">₹25K statutory wage ceiling</div>
              </div>
              <div class="stat-card p-xs bg-canvas border rounded">
                <div class="caption text-muted">In-Hand (Full-Basic PF)</div>
                <div class="font-mono text-body font-bold">{formatINR(breakdownFull.monthlyInHand)} / mo</div>
                <div class="caption text-muted mt-xxs">Uncapped 12% on 40% basic</div>
              </div>
              <div class="stat-card p-xs bg-canvas border rounded">
                <div class="caption text-muted">In-Hand (Historical Baseline)</div>
                <div class="font-mono text-body font-bold">{formatINR(breakdownHistorical.monthlyInHand)} / mo</div>
                <div class="caption text-muted mt-xxs">Pre-Sep 2026 ₹15K ceiling</div>
              </div>
            </div>
            <p class="body-xs text-muted mb-0">
              * <em>Under the New Tax Regime (Tax Year 2026–27), standard deduction of ₹75,000 applies. Gratuity accrual ({formatINR(breakdownNew.gratuity.annualAccrual)}/yr) and Employer PF ({formatINR(breakdownNew.employerPF.annualEmployerPF)}/yr) are retained by the employer as benefits and are not paid out in your monthly bank credit.</em>
            </p>
          </div>

          <h2 class="title-sm mb-sm">Earnings & Cash Components</h2>
          <div class="table-container mb-lg">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Component</th>
                  <th class="text-right">Monthly</th>
                  <th class="text-right">Annual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Basic Salary (40% of CTC)</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.monthlyBasic)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.annualBasic)}</td>
                </tr>
                <tr>
                  <td>House Rent Allowance (HRA)</td>
                  <td class="text-right font-mono">{formatINR(Math.round(breakdownNew.annualHRA / 12))}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.annualHRA)}</td>
                </tr>
                <tr>
                  <td>Special Allowance / Other Allowances</td>
                  <td class="text-right font-mono">{formatINR(Math.round(breakdownNew.annualSpecialAllowance / 12))}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.annualSpecialAllowance)}</td>
                </tr>
                <tr style="font-weight:600; background:var(--color-surface-soft);">
                  <td>Gross Salary</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.monthlyGross)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.annualGross)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 class="title-sm mb-sm">Monthly Deductions</h2>
          <div class="table-container mb-lg">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Deduction Item</th>
                  <th class="text-right">Monthly</th>
                  <th class="text-right">Annual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Employee Provident Fund (12%)</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.monthlyEmployeePF)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.employeePF)}</td>
                </tr>
                <tr>
                  <td>Income Tax (Monthly TDS)</td>
                  <td class="text-right font-mono text-danger">{formatINR(breakdownNew.tax.monthlyTDS)}</td>
                  <td class="text-right font-mono text-danger">{formatINR(breakdownNew.tax.totalTax)}</td>
                </tr>
                <tr>
                  <td>Professional Tax (PT)</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.monthlyProfessionalTax)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.professionalTax)}</td>
                </tr>
                <tr style="font-weight:700; background:rgba(5, 177, 105, 0.08);">
                  <td>Net Monthly Bank Credit (Take-Home)</td>
                  <td class="text-right font-mono text-success">{formatINR(breakdownNew.monthlyInHand)}</td>
                  <td class="text-right font-mono text-success">{formatINR(breakdownNew.annualInHand)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 class="title-sm mb-sm">Employer Non-Cash Contributions (Included in CTC)</h2>
          <div class="table-container mb-base">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Employer Cost Item</th>
                  <th class="text-right">Monthly</th>
                  <th class="text-right">Annual</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Employer PF Contribution (12%)</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.employerPF.monthlyEmployerPF)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.employerPF.annualEmployerPF)}</td>
                </tr>
                <tr>
                  <td>Gratuity Accrual Provision (~4.81% of basic)</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.gratuity.monthlyAccrual)}</td>
                  <td class="text-right font-mono">{formatINR(breakdownNew.gratuity.annualAccrual)}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ═══ 3-Scenario PF Comparison Table ═══ -->
        <div class="card mt-lg">
          <div class="badge badge-primary mb-xs">Statutory Legal Analysis</div>
          <h2 class="title-md mb-xs">Three-Scenario Provident Fund (EPF) Comparison</h2>
          <p class="body-sm text-muted mb-lg">
            Understand how different corporate PF policies affect your bank credit versus retirement corpus. We clearly differentiate mandatory statutory rules from optional corporate schemes.
          </p>

          <div class="table-container mb-lg">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Metric / PF Treatment</th>
                  <th>Scenario 1: Statutory Capped PF (₹25k Ceiling)</th>
                  <th>Scenario 2: Full-Basic PF (Uncapped Voluntary)</th>
                  <th>Scenario 3: Historical Baseline (₹15k Ceiling)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Legal Classification</strong></td>
                  <td><span class="badge badge-success">Statutory Mandate</span></td>
                  <td><span class="badge badge-neutral">Voluntary / Contractual</span></td>
                  <td><span class="badge badge-neutral">Dated Statutory (Pre-Sep 2026)</span></td>
                </tr>
                <tr>
                  <td>Statutory Legal Authority</td>
                  <td class="caption">EPFO Gazette Notification (w.e.f. 17 Sep 2026)</td>
                  <td class="caption">Joint Declaration under Para 26(6) EPF Scheme</td>
                  <td class="caption">Notification S.O. 2259(E) (2014–2026)</td>
                </tr>
                <tr>
                  <td>Monthly PF Wage Base</td>
                  <td class="font-mono">{formatINR(breakdownNew.employerPF.pfWageBase)}</td>
                  <td class="font-mono">{formatINR(breakdownFull.employerPF.pfWageBase)}</td>
                  <td class="font-mono">{formatINR(breakdownHistorical.employerPF.pfWageBase)}</td>
                </tr>
                <tr>
                  <td><strong>Employee PF (Deducted from Salary)</strong></td>
                  <td class="font-mono text-danger">{formatINR(breakdownNew.monthlyEmployeePF)}/mo</td>
                  <td class="font-mono text-danger">{formatINR(breakdownFull.monthlyEmployeePF)}/mo</td>
                  <td class="font-mono text-danger">{formatINR(breakdownHistorical.monthlyEmployeePF)}/mo</td>
                </tr>
                <tr>
                  <td><strong>Employer PF (Retiral Cost in CTC)</strong></td>
                  <td class="font-mono">{formatINR(breakdownNew.employerPF.monthlyEmployerPF)}/mo</td>
                  <td class="font-mono">{formatINR(breakdownFull.employerPF.monthlyEmployerPF)}/mo</td>
                  <td class="font-mono">{formatINR(breakdownHistorical.employerPF.monthlyEmployerPF)}/mo</td>
                </tr>
                <tr style="background: rgba(5, 177, 105, 0.08); font-weight: 700;">
                  <td><strong>Monthly In-Hand Bank Credit</strong></td>
                  <td class="font-mono text-success">{formatINR(breakdownNew.monthlyInHand)}</td>
                  <td class="font-mono text-success">{formatINR(breakdownFull.monthlyInHand)}</td>
                  <td class="font-mono text-success">{formatINR(breakdownHistorical.monthlyInHand)}</td>
                </tr>
                <tr>
                  <td>Annual Take-Home Pay</td>
                  <td class="font-mono">{formatINR(breakdownNew.annualInHand)}</td>
                  <td class="font-mono">{formatINR(breakdownFull.annualInHand)}</td>
                  <td class="font-mono">{formatINR(breakdownHistorical.annualInHand)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="alert alert-info p-md">
